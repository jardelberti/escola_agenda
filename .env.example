# Arquivo de configuração de ambiente
# Altere estes valores conforme sua necessidade.

# Credenciais do Banco de Dados PostgreSQL
POSTGRES_USER=agenda_user
POSTGRES_PASSWORD=sua_senha_super_segura_aqui
POSTGRES_DB=agenda_db

# Porta que a aplicação irá usar no seu servidor (Host)
HOST_PORT=5000

# Chave secreta da aplicação Flask
SECRET_KEY=sua_chave_secreta_super_segura_aqui

# Produção: HTTPS obrigatório. Em desenvolvimento HTTP SOMENTE em localhost,
# use COOKIE_SECURE=false e PUBLIC_BASE_URL=http://localhost:5000.
COOKIE_SECURE=true
PUBLIC_BASE_URL=https://agendaricardo.com.br
# Chave exclusiva do coletor de saúde (gerar aleatoriamente; não reutilizar tokens).
MONITOR_API_KEY=

# Chave de integração para APIs externas (n8n, bots de WhatsApp, etc.)
INTEGRATION_API_KEY=sua_chave_de_integracao_aqui

# Nome da imagem Docker da sua aplicação
APP_IMAGE=jardelberti/agenda.escola:latest
